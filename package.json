{
  "name": "ecorse-afric-btp-manager-360",
  "version": "0.1.0",
  "private": true,
  "description": "ERP BTP d'ECORSE AFRIC : chantiers, parties prenantes, études, finances, QHSE.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "creer-admin": "tsx scripts/creer-admin.ts",
    "test": "vitest run",
    "test:e2e": "export DATABASE_URL=${DATABASE_URL_TEST:-postgresql://ecorse:ecorse_dev@localhost:5432/ecorse_btp_test}; DIRECT_URL=$DATABASE_URL prisma migrate deploy && playwright test",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
