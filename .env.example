# ---- Copier en .env et compléter. Ne jamais committer le fichier .env. ----

# Adresse publique de l'application (sert aux liens des e-mails et au retour de Wave)
APP_URL=https://app.votre-domaine.sn
# 1 obligatoire en production (HTTPS)
COOKIE_SECURE=1
NOM_PRODUIT=BTP Manager 360
INSCRIPTION_OUVERTE=1
PORT=3000

# PostgreSQL (docker-compose construit DATABASE_URL à partir de ce mot de passe)
POSTGRES_PASSWORD=changez-moi-mot-de-passe-long
# Hors docker-compose (hébergeur avec PostgreSQL géré) : renseigner directement
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base

# Essai gratuit et tarif de l'abonnement
ESSAI_HEURES=24
ABONNEMENT_PRIX_MENSUEL_XOF=

# Wave Checkout (compte Wave Business > Développeurs)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# Brevo (e-mails transactionnels) : clé API + adresse d'expéditeur vérifiée dans Brevo
BREVO_API_KEY=
EMAIL_EXPEDITEUR=no-reply@votre-domaine.sn
EMAIL_EXPEDITEUR_NOM=BTP Manager 360
