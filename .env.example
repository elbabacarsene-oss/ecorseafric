# Chaîne de connexion utilisée par l'application (ne jamais committer la vraie valeur).
# Supabase : URL du « Transaction pooler » (port 6543) suivie de ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:6543/postgres?pgbouncer=true&connection_limit=1"
# Connexion directe pour les migrations. Supabase : « Session pooler » ou connexion directe (port 5432).
# En local, mettre la même valeur que DATABASE_URL.
DIRECT_URL="postgresql://utilisateur:motdepasse@hote:5432/postgres"
